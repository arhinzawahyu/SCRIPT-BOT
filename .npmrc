; Baileys 7.0.0-rc14 mengambil libsignal dari git, bukan dari registry:
;   "resolved": "git+ssh://git@github.com/whiskeysockets/libsignal-node.git#bcea72df"
; npm >= 12 memblokir dependensi git secara default (EALLOWGIT). Tanpa baris ini,
; `npm install` berhenti sebelum mengunduh apa pun.
; `all` wajib, bukan `root`: libsignal adalah dependensi transitif lewat baileys,
; tidak terdaftar di package.json, jadi `root` tetap akan menolak.
; Ini melonggarkan proteksi anti-sisip, tapi risikonya kecil dan terukur: hanya
; satu paket yang boleh, dan commit hash-nya sudah dipin di package-lock.json,
; jadi isinya tidak bisa berubah diam-diam.
allow-git=all
